@{
    DateTime today = DateTime.Now;

    bool isWeekend = today.DayOfWeek == DayOfWeek.Saturday ||
                     today.DayOfWeek == DayOfWeek.Sunday;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Weekend Check</title>
</head>

<body>

    <h1>Kiểm tra ngày hôm nay</h1>

    @if (isWeekend)
    {
        <h2>Have nice weekend</h2>
    }
    else
    {
        <h2>Today is not weekend</h2>
    }

</body>
</html>